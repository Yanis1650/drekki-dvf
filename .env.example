# Foncier-Express - Variables d'environnement
# Copier ce fichier vers .env et adapter les valeurs

# === DuckDB (OLAP) ===
DUCKDB_PATH=./data/foncier.duckdb
DATA_DIR=./data
MULTI_DEPT=false

# === PostgreSQL/PostGIS (OLTP - utilisateurs, crédits) ===
POSTGIS_HOST=localhost
POSTGIS_PORT=5433
POSTGIS_USER=foncier
POSTGIS_PASSWORD=changeme
POSTGIS_DB=foncier_express

# === API (optionnel) ===
API_TITLE=Foncier-Express API
API_VERSION=0.1.0

# === Cartographie (optionnel - IGN utilisé par défaut, gratuit) ===
# MAPBOX_ACCESS_TOKEN=sk.xxx  # Pour fonds Mapbox si souhaité
