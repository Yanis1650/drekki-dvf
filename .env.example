# Foncier-Express - Variables d'environnement
# Copier ce fichier vers .env et adapter les valeurs.
#
# L'application est libre et sans compte : aucune base transactionnelle,
# aucun secret de paiement, aucune clé d'API obligatoire.

# === DuckDB (base analytique, lecture seule) ===
# Base par département construite par le pipeline ETL.
DUCKDB_PATH=./data/dept35.duckdb
DATA_DIR=./data

# Routage multi-départements : cherche data/dept{XX}.duckdb selon la parcelle.
MULTI_DEPT=false

# Garde-fou optionnel si une base unique couvre plusieurs départements
# (ex. foncier.duckdb France entière). Laisser vide sinon.
# DEPT_PREFIX=35

# === API ===
API_TITLE=Foncier-Express API
API_VERSION=0.1.0

# Origines autorisées (CORS). Pour le déploiement public, conserver le domaine
# réel ; en développement local, utiliser par exemple http://localhost:5173.
CORS_ALLOW_ORIGINS=https://foncier-express.drekky.fr
