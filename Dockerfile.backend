# Foncier-Express Backend - FastAPI + DuckDB
FROM python:3.11-slim

# Install system dependencies for geospatial
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgdal-dev \
    libproj-dev \
    libgeos-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set work directory
WORKDIR /app

# Copier le package avant son installation : l'image est réellement buildable
# en CI comme en production, au lieu de tenter d'installer un projet vide.
COPY pyproject.toml README.md ./
COPY app/ ./app/
COPY data-pipeline/ ./data-pipeline/

# Navigateurs Playwright hors de /root : le service ne tourne pas en root et
# doit pouvoir lancer Chromium. Variable lue a l'installation et a l'execution.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# Install Python dependencies. setuptools a jour : pip-audit signalait la
# version livree par l'image de base (PYSEC-2026-3447).
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir . && \
    playwright install-deps && \
    playwright install chromium

# Utilisateur sans privileges. Chromium tourne en --no-sandbox (necessaire en
# conteneur) et rend du HTML : en root, une faille du navigateur donnait root
# dans le conteneur. La base est montee en lecture seule, lisible par tous ;
# DuckDB et les PDF n'ecrivent que dans /tmp. Une migration de la base passe
# donc par un conteneur jetable lance avec `--user "$(id -u)"`.
RUN mkdir -p /app/data && \
    useradd --system --uid 10001 --create-home --home-dir /home/foncier \
        --shell /usr/sbin/nologin foncier
USER foncier

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health/ready || exit 1

# 2 workers : Chromium (PDF) + DuckDB
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
